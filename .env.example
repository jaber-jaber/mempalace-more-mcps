MEMPALACE_REPO=/absolute/path/to/mempalace
MEMPALACE_PYTHON=/absolute/path/to/python
MEMPALACE_LOG_DIR=/absolute/path/to/.mempalace/logs

# Example:
# /mnt/c/users/yourname/Obsidian/synced-vault
MEMPALACE_OBSIDIAN_PATH=/absolute/path/to/obsidian/vault

# Leave blank to use the built-in seeded broad sync behavior.
MEMPALACE_NOTION_SYNC_LIMIT=100
MEMPALACE_NOTION_SYNC_QUERY=

# Set to 1 to disable either sync path.
MEMPALACE_SKIP_NOTION=0
MEMPALACE_SKIP_OBSIDIAN=0
